# Copy to the project root as .env on the VPS.
# This app shares the Hostinger VPS with an existing site on port 80,
# so Learning Banyan listens on 8080: http://YOUR_VPS_IPV4:8080/

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string

# VPS IPv4 (no domain required)
PUBLIC_HOST=YOUR_VPS_IPV4
PUBLIC_PORT=8080
PUBLIC_SCHEME=http
SITE_URL=http://YOUR_VPS_IPV4:8080
ALLOWED_HOSTS=YOUR_VPS_IPV4,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://YOUR_VPS_IPV4:8080

# Keep HTTP — Let's Encrypt needs a domain name
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Gunicorn public port (existing website stays on 80)
PORT=8080
WEB_CONCURRENCY=2

# Default: SQLite file on the VPS disk (persistent).
# To use Hostinger MySQL instead, uncomment:
# DATABASE_ENGINE=django.db.backends.mysql
# DATABASE_NAME=learningbanyan
# DATABASE_USER=your_mysql_user
# DATABASE_PASSWORD=your_mysql_password
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
