# Local / Vercel. SECRET_KEY is optional — a fallback is generated if unset.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Default database is SQLite (db.sqlite3). Optional Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/learningbanyan

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.vercel.app

CORS_ALLOW_ALL_ORIGINS=True
LOG_LEVEL=INFO

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
